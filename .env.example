# Copie este arquivo para ".env" e preencha com os dados reais.
# O .env NUNCA deve ser versionado nem compartilhado.

# URL da tela de LOGIN do Geweb (nao a do menu).
# Depois de autenticar, o sistema leva sozinho para /sistema/menu.php
GEWEB_URL=https://sistemas.sogamax.com.br/sistema/login.php

# Credenciais de acesso ao Geweb
GEWEB_USUARIO=seu.usuario
GEWEB_SENHA=sua-senha

# Pasta onde os relatorios baixados sao gravados, no formato bruto do Geweb
DOWNLOAD_DIR=downloads

# Pasta onde vai o .xlsx ja formatado, pronto para enviar a industria.
# Espelha a estrutura de DOWNLOAD_DIR (fabricante\periodo\arquivo.xlsx).
FORMATADO_DIR=formatado

# --- Disparo (python -m src.disparo) ------------------------------------------------
# Este comando ENVIA de verdade. Ele pergunta antes (digite SIM), e --dry-run mostra
# tudo sem enviar. --rascunho volta a gerar .eml para envio manual.

# Pasta dos rascunhos, usada so com --rascunho.
ENVIOS_DIR=envios

# Nome que assina o e-mail e o WhatsApp.
COMPRADOR=YURI TOSO

# Remetente do .eml. Deixe VAZIO para o Outlook usar a conta de quem abrir o arquivo —
# assim o e-mail sai da caixa do comprador, com o nome dele.
REMETENTE=

# Para onde a industria responde, se for diferente do remetente.
RESPONDER_PARA=

# TRAVAS DE TESTE: com um endereco/telefone aqui, TUDO daquele canal vai para ele e nenhuma
# industria e tocada. As duas sao INDEPENDENTES: preencher so uma deixa o outro canal
# enviando de verdade. Mantenha as duas preenchidas ate a homologacao terminar.
# O DESTINATARIO_TESTE aceita mais de um endereco, separados por virgula — util para o
# comprador acompanhar a homologacao sem precisar desligar a trava.
DESTINATARIO_TESTE=

# Quem e avisado por e-mail quando a rodada FALHA (relatorio que nao saiu, fabricante que
# ficou de fora por erro de cadastro, envio que nao entregou). Aceita varios enderecos
# separados por virgula. Vazio nao desliga o alerta: cai no RESPONDER_PARA e, na falta
# dele, na propria caixa que envia. Nao ha e-mail quando a rodada termina limpa.
ALERTA_PARA=
TELEFONE_TESTE=

# --- Envio por e-mail (SMTP) --------------------------------------------------------
# Caixa de Email Locaweb: servidor email-ssl.com.br, porta 465, SSL.
# O usuario e o endereco COMPLETO, e precisa ser o mesmo do remetente — a Locaweb
# recusa com 503 se a conta autenticada for diferente de quem assina a mensagem.
SMTP_HOST=email-ssl.com.br
SMTP_PORTA=465
SMTP_SEGURANCA=ssl
SMTP_USUARIO=
SMTP_SENHA=

# --- Envio por WhatsApp (API nao oficial) -------------------------------------------
# Vazio ate contratar o provedor; ate la o canal e pulado com aviso.
# ATENCAO: API nao oficial contraria os termos da Meta e o numero pode ser banido.
# Use um numero dedicado, nunca o pessoal do comprador.
WHATSAPP_PROVEDOR=zapi
ZAPI_URL_BASE=https://api.z-api.io
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Segundos entre um laboratorio e o proximo. Rajada e o padrao que faz banir numero.
INTERVALO_ENVIO_S=5

# --- Limites de seguranca -----------------------------------------------------------
# Os padroes ja protegem: sao 24 laboratorios reais, e a Locaweb aceita 100/hora por caixa.

# Recusa a leva se ela tiver mais mensagens que isto. Pega cadastro duplicado e manifesto
# errado antes de conectar. --forcar libera pontualmente.
MAX_ENVIOS_POR_RODADA=30

# Teto por hora, por canal. Abaixo do limite do provedor, de proposito.
MAX_ENVIOS_POR_HORA=90

# Falhas seguidas que desligam um canal. Insistir com servidor que ja recusou e o que faz
# um provedor suspender a conta.
MAX_FALHAS_SEGUIDAS=3

# Tentativas por mensagem (1 + 2 retentativas). So vale para erro TEMPORARIO (4xx, queda de
# conexao); erro permanente e credencial recusada nunca sao repetidos.
MAX_TENTATIVAS=3

# Recusa anexo acima disto, em MB. Um mapa formatado tem menos de 100 KB.
MAX_ANEXO_MB=10

# --- Navegador ----------------------------------------------------------------------
# false = abre o navegador na tela (use durante o desenvolvimento)
# true  = roda invisivel (use depois de validado, no agendamento)
HEADLESS=false

# Timeout padrao das acoes de tela, em milissegundos
TIMEOUT_MS=30000

# Timeout especifico da geracao do relatorio (costuma demorar), em milissegundos
TIMEOUT_RELATORIO_MS=180000

# Atraso artificial entre acoes, em ms. Util para depurar (ex.: 300). 0 = desligado.
SLOW_MO_MS=0
